# Variáveis usadas pelo Render (ou outro host). Em dev, não precisa criar .env;
# os defaults em application.properties já funcionam localmente.

# Profile de produção (ativa application-prod.properties)
SPRING_PROFILES_ACTIVE=prod

# Porta. O Render injeta automaticamente.
PORT=8080

# Segurança — gere com: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# CORS — URL da Vercel separada por vírgula
CORS_ORIGINS=https://seu-projeto.vercel.app

# Postgres (Render Postgres → use a "Internal Database URL")
# Formato esperado: jdbc:postgresql://HOST:5432/DBNAME
DATABASE_URL=
DB_USER=
DB_PASS=

# Gateway de pagamento Pix
# "simulated" (default, sem cobrança real) ou "mercadopago"
PAGAMENTO_GATEWAY=simulated

# Credenciais Mercado Pago — obrigatórias se PAGAMENTO_GATEWAY=mercadopago
# Gere em https://www.mercadopago.com.br/developers/panel/app
# Sandbox: APP_USR-... (TEST)  |  Produção: APP_USR-... (PROD)
MERCADOPAGO_ACCESS_TOKEN=
# Secret para validar assinatura dos webhooks (opcional mas recomendado)
MERCADOPAGO_WEBHOOK_SECRET=
