# Variáveis usadas pelo Render (ou outro host). Em dev, não precisa criar .env;
# os defaults em application.properties já funcionam localmente.

# Profile de produção (ativa application-prod.properties)
SPRING_PROFILES_ACTIVE=prod

# Porta. O Render injeta automaticamente.
PORT=8080

# Segurança — gere com: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# CORS — URL da Vercel separada por vírgula
CORS_ORIGINS=https://seu-projeto.vercel.app

# Postgres (Render Postgres → use a "Internal Database URL")
# Formato esperado: jdbc:postgresql://HOST:5432/DBNAME
DATABASE_URL=
DB_USER=
DB_PASS=

# Gateway de pagamento — Pix, Cartão e Boleto
# "simulated" (default, sem cobrança real) ou "mercadopago"
PAGAMENTO_GATEWAY=simulated

# Credenciais Mercado Pago — obrigatórias se PAGAMENTO_GATEWAY=mercadopago
# Gere em https://www.mercadopago.com.br/developers/panel/app
# Sandbox: TEST-...  |  Produção: APP_USR-...
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Secret HMAC para validar assinatura dos webhooks (em Painel MP → Notificações → Webhooks).
# Recomendado em produção; sem ele, o endpoint aceita qualquer chamada.
MERCADOPAGO_WEBHOOK_SECRET=

# Taxa de conveniência repassada ao pagador no SimulatedCartaoGateway (4,99% default).
# Em produção com Mercado Pago real, a taxa vem do gateway (fee_details).
CARTAO_TAXA_CONVENIENCIA=0.0499

# Push notifications (FCM via Firebase Admin SDK)
# Quando true, requer credenciais; do contrário fica em MOCK (log + SSE in-app).
PUSH_ENABLED=false
# Conteúdo JSON do service-account.json (recomendado para hosts como Render).
# Cole o JSON inteiro em uma linha; aspas podem precisar de escape conforme o host.
FIREBASE_CREDENTIALS_JSON=
# Alternativa: caminho para arquivo no filesystem do container.
FIREBASE_CREDENTIALS_PATH=

# LGPD — versão atual da política. Mude quando publicar versão nova para forçar re-consentimento.
LGPD_POLITICA_VERSAO=2026-01-01

# Google Login (OAuth 2.0)
GOOGLE_CLIENT_ID=
