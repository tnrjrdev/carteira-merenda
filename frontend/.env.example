# URL base da API. Em dev pode deixar vazio para usar o proxy do Vite.
# Em produção (Vercel), defina a URL pública do backend no Render.
# Exemplo: VITE_API_URL=https://merenda-backend.onrender.com/api
VITE_API_URL=

# Google Login (OAuth 2.0) — Client ID do Google Cloud (Web)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Mercado Pago — Public Key (TEST-... em sandbox, APP_USR-... em produção).
# Necessária para que o Card Brick apareça em CartaoModal e tokenize o cartão.
VITE_MERCADOPAGO_PUBLIC_KEY=

# Firebase Cloud Messaging — tudo opcional. Sem preencher, push fica em modo MOCK local.
# Console: https://console.firebase.google.com → Configurações do projeto → SDK para Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VAPID Web Push (Configurações do projeto → Cloud Messaging → Web Push certificates)
VITE_FIREBASE_VAPID_KEY=
